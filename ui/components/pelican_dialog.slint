import { Theme } from "../style.slint";
import { ScrollView } from "std-widgets.slint";

export struct PelicanDialogCardItem {
    id: string,
    published_at_str: string,
    url: string,
    has_image: bool,
    img: image,
}

export struct PelicanDialogPairItem {
    left: PelicanDialogCardItem,
    has_right: bool,
    right: PelicanDialogCardItem,
}

component PelicanImageCard inherits Rectangle {
    in property <float> scale: 1.0;
    in property <PelicanDialogCardItem> item;
    callback open_image_url(string);

    background: rgba(255, 255, 255, 0.03);
    border-radius: 6px * root.scale;
    border-width: 1px;
    border-color: ta_card.has-hover ? #38bdf8 : rgba(255, 255, 255, 0.08);
    clip: true;

    VerticalLayout {
        padding: 4px * root.scale;
        spacing: 3px * root.scale;

        // Image Area
        Rectangle {
            height: 104px * root.scale;
            background: rgba(0, 0, 0, 0.35);
            border-radius: 4px * root.scale;
            clip: true;

            if root.item.has-image: Image {
                source: root.item.img;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }

            if !root.item.has-image: Text {
                text: "🖼️ 图片加载中...";
                font-size: 9px * root.scale;
                color: #64748b;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Timestamp Footer
        Rectangle {
            height: 17px * root.scale;
            background: rgba(15, 23, 42, 0.85);
            border-radius: 3px * root.scale;

            HorizontalLayout {
                padding-left: 6px * root.scale;
                padding-right: 6px * root.scale;
                alignment: space-between;

                Text {
                    text: "🕒 " + root.item.published-at-str;
                    font-size: 8px * root.scale;
                    font-weight: 600;
                    color: #cbd5e1;
                    vertical-alignment: center;
                }

                Text {
                    text: "🔗 查看大图";
                    font-size: 7.5px * root.scale;
                    color: #38bdf8;
                    vertical-alignment: center;
                }
            }
        }
    }

    ta_card := TouchArea {
        clicked => { root.open_image_url(root.item.url); }
    }
}

export component PelicanDialog inherits Rectangle {
    in property <float> scale: 1.0;
    in property <string> provider_code: "A018-Plus/K12";
    in property <string> status_text: "共 0 张实测图";
    in property <[PelicanDialogPairItem]> pairs: [];

    callback close();
    callback open_image_url(string);

    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.75);

    // Backdrop click to close
    TouchArea {
        clicked => { root.close(); }
    }

    // Modal Card
    Rectangle {
        width: min(parent.width - 20px, 740px * root.scale);
        height: min(parent.height - 20px, 340px * root.scale);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: rgba(15, 23, 42, 0.98);
        border-radius: 10px * root.scale;
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.15);
        clip: true;

        VerticalLayout {
            padding: 10px * root.scale;
            spacing: 8px * root.scale;

            // Header Bar
            HorizontalLayout {
                alignment: space-between;
                height: 22px * root.scale;

                HorizontalLayout {
                    spacing: 8px * root.scale;
                    alignment: start;

                    Text {
                        text: root.provider_code + " 鹈鹕实测图";
                        font-size: 11px * root.scale;
                        font-weight: 800;
                        color: #f1f5f9;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.status_text;
                        font-size: 9px * root.scale;
                        color: #94a3b8;
                        vertical-alignment: center;
                    }
                }

                // Close Button
                Rectangle {
                    width: 20px * root.scale;
                    height: 20px * root.scale;
                    border-radius: 10px * root.scale;
                    background: ta_close.has-hover ? rgba(239, 68, 68, 0.25) : rgba(255, 255, 255, 0.08);

                    Text {
                        text: "×";
                        font-size: 11px * root.scale;
                        font-weight: 800;
                        color: ta_close.has-hover ? #ef4444 : #94a3b8;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    ta_close := TouchArea {
                        clicked => { root.close(); }
                    }
                }
            }

            // Divider
            Rectangle {
                height: 1px;
                background: rgba(255, 255, 255, 0.08);
            }

            // Image Gallery Scroll Area
            ScrollView {
                height: parent.height - 48px * root.scale;

                VerticalLayout {
                    spacing: 8px * root.scale;
                    alignment: start;

                    if root.pairs.length == 0: Rectangle {
                        height: 160px * root.scale;
                        Text {
                            text: "⏳ 正在加载实测图记录，请稍候...";
                            font-size: 11px * root.scale;
                            color: #94a3b8;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // 2-column side-by-side grid
                    for pair in root.pairs: HorizontalLayout {
                        spacing: 8px * root.scale;
                        height: 135px * root.scale;

                        PelicanImageCard {
                            horizontal-stretch: 1;
                            scale: root.scale;
                            item: pair.left;
                            open_image_url(url) => { root.open_image_url(url); }
                        }

                        if pair.has_right: PelicanImageCard {
                            horizontal-stretch: 1;
                            scale: root.scale;
                            item: pair.right;
                            open_image_url(url) => { root.open_image_url(url); }
                        }

                        if !pair.has_right: Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }
}
