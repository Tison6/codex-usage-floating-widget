import { Theme } from "../style.slint";

export struct DialogProviderItem {
    code: string,
    multiplier_str: string,
    effective_multiplier_str: string,
    cache_hit_rate: string,
    ttft_str: string,
    success_rate_str: string,
    detection_status: string,
    has_image: bool,
    is_selected: bool,
    is_excluded: bool,
}

export component AIHubFilterDialog inherits Rectangle {
    in property <float> scale: 1.0;
    in property <bool> is_auto_mode: true;
    in property <int> selected_count: 4;
    in property <int> excluded_count: 0;
    in property <int> total_count: 28;
    in-out property <[DialogProviderItem]> providers: [];

    callback close_dialog();
    callback save_and_apply();
    callback toggle_mode(bool);
    callback toggle_provider_selected(int, bool);
    callback toggle_provider_excluded(int, bool);
    callback drag_window();

    background: rgba(15, 23, 42, 0.98);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);

    // Consume clicks inside dialog so backdrop TouchArea does not trigger
    TouchArea {}

    VerticalLayout {
        padding: 10px * root.scale;
        spacing: 8px * root.scale;

        // Title Bar
        Rectangle {
            height: 22px * root.scale;
            TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        root.drag_window();
                    }
                }
            }

            HorizontalLayout {
                alignment: space-between;

                HorizontalLayout {
                    spacing: 4px * root.scale;
                    Text {
                        text: "⚙ 勾选 AIHub 监控供应商 (实时参数筛选)";
                        font-size: 11.5px * root.scale;
                        font-weight: 700;
                        color: #f8fafc;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 18px * root.scale;
                    height: 18px * root.scale;
                    border-radius: 9px * root.scale;
                    background: rgba(255, 255, 255, 0.05);

                    Text {
                        text: "×";
                        font-size: 11px * root.scale;
                        color: #94a3b8;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => { root.close_dialog(); }
                    }
                }
            }
        }

        // Mode Selector
        HorizontalLayout {
            spacing: 8px * root.scale;

            Rectangle {
                background: root.is_auto_mode ? rgba(16, 185, 129, 0.25) : rgba(255, 255, 255, 0.05);
                border-width: 1px;
                border-color: root.is_auto_mode ? #10b981 : rgba(255, 255, 255, 0.1);
                border-radius: 4px * root.scale;
                height: 24px * root.scale;

                HorizontalLayout {
                    padding-left: 8px * root.scale;
                    padding-right: 8px * root.scale;
                    alignment: center;

                    Text {
                        text: "🤖 自动模式 (按默认阈值每分钟动态更新)";
                        font-size: 10px * root.scale;
                        font-weight: 600;
                        color: root.is_auto_mode ? #34d399 : #94a3b8;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    clicked => { root.toggle_mode(true); }
                }
            }

            Rectangle {
                background: !root.is_auto_mode ? rgba(59, 130, 246, 0.25) : rgba(255, 255, 255, 0.05);
                border-width: 1px;
                border-color: !root.is_auto_mode ? #3b82f6 : rgba(255, 255, 255, 0.1);
                border-radius: 4px * root.scale;
                height: 24px * root.scale;

                HorizontalLayout {
                    padding-left: 8px * root.scale;
                    padding-right: 8px * root.scale;
                    alignment: center;

                    Text {
                        text: "✋ 手动模式 (按勾选项监控)";
                        font-size: 10px * root.scale;
                        font-weight: 600;
                        color: !root.is_auto_mode ? #60a5fa : #94a3b8;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    clicked => { root.toggle_mode(false); }
                }
            }
        }

        // Table Header
        HorizontalLayout {
            spacing: 4px * root.scale;
            height: 20px * root.scale;

            Rectangle { width: 22px * root.scale; Text { text: "选"; font-size: 9px * root.scale; font-weight: 700; color: #10b981; horizontal-alignment: center; vertical-alignment: center; } }
            Rectangle { width: 26px * root.scale; Text { text: "剔除"; font-size: 9px * root.scale; font-weight: 700; color: #ef4444; horizontal-alignment: center; vertical-alignment: center; } }
            Text { text: "检测 / 供应商代码"; font-size: 9.5px * root.scale; font-weight: 700; color: #64748b; horizontal-alignment: left; vertical-alignment: center; }

            Rectangle { width: 44px * root.scale; Text { text: "倍率"; font-size: 9.5px * root.scale; font-weight: 700; color: #64748b; horizontal-alignment: center; vertical-alignment: center; } }
            Rectangle { width: 50px * root.scale; Text { text: "真实倍率"; font-size: 9.5px * root.scale; font-weight: 700; color: #64748b; horizontal-alignment: center; vertical-alignment: center; } }
            Rectangle { width: 46px * root.scale; Text { text: "缓存率"; font-size: 9.5px * root.scale; font-weight: 700; color: #64748b; horizontal-alignment: center; vertical-alignment: center; } }
            Rectangle { width: 44px * root.scale; Text { text: "TTFT"; font-size: 9.5px * root.scale; font-weight: 700; color: #64748b; horizontal-alignment: center; vertical-alignment: center; } }
            Rectangle { width: 50px * root.scale; Text { text: "成功率"; font-size: 9.5px * root.scale; font-weight: 700; color: #64748b; horizontal-alignment: center; vertical-alignment: center; } }
            Rectangle { width: 40px * root.scale; Text { text: "实测图"; font-size: 9.5px * root.scale; font-weight: 700; color: #64748b; horizontal-alignment: center; vertical-alignment: center; } }
        }

        // Table Provider List
        Flickable {
            content-height: root.providers.length * (27px * root.scale);

            VerticalLayout {
                spacing: 3px * root.scale;

                for p[idx] in root.providers: Rectangle {
                    background: p.is_excluded ? rgba(239, 68, 68, 0.05) : (p.is_selected ? rgba(16, 185, 129, 0.06) : rgba(255, 255, 255, 0.02));
                    border-radius: 4px * root.scale;
                    height: 25px * root.scale;

                    HorizontalLayout {
                        padding: 3px * root.scale;
                        spacing: 4px * root.scale;

                        // Column 1: Select Checkbox (选)
                        Rectangle {
                            width: 22px * root.scale;
                            Rectangle {
                                width: 14px * root.scale;
                                height: 14px * root.scale;
                                border-radius: 3px * root.scale;
                                border-width: 1px;
                                border-color: p.is_selected ? #10b981 : rgba(255, 255, 255, 0.2);
                                background: p.is_selected ? #10b981 : transparent;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;

                                if p.is_selected: Text {
                                    text: "✓";
                                    font-size: 9px * root.scale;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => {
                                    if !p.is_excluded {
                                        root.toggle_provider_selected(idx, !p.is_selected);
                                    }
                                }
                            }
                        }

                        // Column 2: Exclude Checkbox (剔除)
                        Rectangle {
                            width: 26px * root.scale;
                            Rectangle {
                                width: 14px * root.scale;
                                height: 14px * root.scale;
                                border-radius: 3px * root.scale;
                                border-width: 1px;
                                border-color: p.is_excluded ? #ef4444 : rgba(239, 68, 68, 0.4);
                                background: p.is_excluded ? #ef4444 : transparent;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;

                                if p.is_excluded: Text {
                                    text: "×";
                                    font-size: 11px * root.scale;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => {
                                    root.toggle_provider_excluded(idx, !p.is_excluded);
                                }
                            }
                        }

                        // Detection Dot
                        Rectangle {
                            width: 12px * root.scale;
                            Rectangle {
                                width: 7px * root.scale;
                                height: 7px * root.scale;
                                border-radius: 3.5px * root.scale;
                                background: p.detection_status == "passed" ? #10b981 : (p.detection_status == "suspected" ? #f59e0b : #64748b);
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        // Provider Code
                        Text {
                            text: p.code;
                            font-size: 10px * root.scale;
                            font-weight: 600;
                            color: p.is_excluded ? #64748b : #e2e8f0;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                        }

                        // Nominal Multiplier
                        Rectangle {
                            width: 44px * root.scale;
                            Text {
                                text: p.multiplier_str;
                                font-size: 9.5px * root.scale;
                                color: #60a5fa;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }

                        // Effective Multiplier
                        Rectangle {
                            width: 50px * root.scale;
                            Text {
                                text: p.effective_multiplier_str;
                                font-size: 9.5px * root.scale;
                                font-weight: 700;
                                color: #34d399;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }

                        // Cache Hit Rate
                        Rectangle {
                            width: 46px * root.scale;
                            Text {
                                text: p.cache_hit_rate;
                                font-size: 9.5px * root.scale;
                                color: #94a3b8;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }

                        // TTFT
                        Rectangle {
                            width: 44px * root.scale;
                            Text {
                                text: p.ttft_str;
                                font-size: 9.5px * root.scale;
                                color: #94a3b8;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }

                        // Success Rate
                        Rectangle {
                            width: 50px * root.scale;
                            Text {
                                text: p.success_rate_str;
                                font-size: 9.5px * root.scale;
                                font-weight: 700;
                                color: #10b981;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }

                        // Image icon
                        Rectangle {
                            width: 40px * root.scale;
                            Text {
                                text: p.has_image ? "📷" : "-";
                                font-size: 9.5px * root.scale;
                                color: p.has_image ? #10b981 : #475569;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Footer: Count summary & Save button
        HorizontalLayout {
            alignment: space-between;

            Text {
                text: "已勾选: " + root.selected_count + "  |  🚫 已剔除: " + root.excluded_count + "  |  总计: " + root.total_count + " 个供应商";
                font-size: 9.5px * root.scale;
                color: #94a3b8;
                vertical-alignment: center;
            }

            Rectangle {
                background: #10b981;
                border-radius: 4px * root.scale;
                height: 24px * root.scale;

                HorizontalLayout {
                    padding-left: 10px * root.scale;
                    padding-right: 10px * root.scale;
                    alignment: center;

                    Text {
                        text: "保存并应用";
                        font-size: 10px * root.scale;
                        font-weight: 700;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    clicked => { root.save_and_apply(); }
                }
            }
        }
    }
}

export struct SquareDialogGroupItem {
    name: string,
    model: string,
    multiplier: string,
    tps: string,
    latency: string,
    success_rate: string,
    is_selected: bool,
}

export struct SquareDialogModelItem {
    name: string,
    label: string,
    supported_groups_count: int,
    is_selected: bool,
}

export component SquareFilterDialog inherits Rectangle {
    in property <float> scale: 1.0;
    in-out property <int> active_tab: 0;
    in property <int> selected_groups_count: 4;
    in property <int> total_groups_count: 32;
    in property <int> selected_models_count: 4;
    in property <int> total_models_count: 24;
    in-out property <[SquareDialogGroupItem]> groups: [];
    in-out property <[SquareDialogModelItem]> models: [];

    callback close_dialog();
    callback save_and_apply();
    callback toggle_group_selected(int, bool);
    callback toggle_model_selected(int, bool);
    callback select_all_groups();
    callback clear_all_groups();
    callback select_all_models();
    callback clear_all_models();
    callback apply_preset();
    callback drag_window();

    background: rgba(15, 23, 42, 0.98);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);

    // Consume clicks inside dialog so backdrop TouchArea does not trigger
    TouchArea {}

    VerticalLayout {
        padding: 10px * root.scale;
        spacing: 8px * root.scale;

        // Title Bar
        Rectangle {
            height: 22px * root.scale;
            TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        root.drag_window();
                    }
                }
            }

            HorizontalLayout {
                alignment: space-between;

                HorizontalLayout {
                    spacing: 4px * root.scale;
                    Text {
                        text: "⚙ 勾选 Square 监控项 (实时生效)";
                        font-size: 11.5px * root.scale;
                        font-weight: 700;
                        color: #f8fafc;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 18px * root.scale;
                    height: 18px * root.scale;
                    border-radius: 9px * root.scale;
                    background: rgba(255, 255, 255, 0.05);

                    Text {
                        text: "×";
                        font-size: 11px * root.scale;
                        color: #94a3b8;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => { root.close_dialog(); }
                    }
                }
            }
        }

        // Two Tabs: Groups vs Models
        HorizontalLayout {
            spacing: 6px * root.scale;
            height: 26px * root.scale;

            Rectangle {
                background: root.active_tab == 0 ? rgba(59, 130, 246, 0.25) : rgba(255, 255, 255, 0.05);
                border-width: 1px;
                border-color: root.active_tab == 0 ? rgba(59, 130, 246, 0.5) : rgba(255, 255, 255, 0.08);
                border-radius: 4px * root.scale;

                HorizontalLayout {
                    padding-left: 10px * root.scale;
                    padding-right: 10px * root.scale;
                    alignment: center;
                    Text {
                        text: "1. 勾选关注分组 (含实时参数)";
                        font-size: 10px * root.scale;
                        font-weight: 600;
                        color: root.active_tab == 0 ? #60a5fa : #94a3b8;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    clicked => { root.active_tab = 0; }
                }
            }

            Rectangle {
                background: root.active_tab == 1 ? rgba(59, 130, 246, 0.25) : rgba(255, 255, 255, 0.05);
                border-width: 1px;
                border-color: root.active_tab == 1 ? rgba(59, 130, 246, 0.5) : rgba(255, 255, 255, 0.08);
                border-radius: 4px * root.scale;

                HorizontalLayout {
                    padding-left: 10px * root.scale;
                    padding-right: 10px * root.scale;
                    alignment: center;
                    Text {
                        text: "2. 勾选关注模型";
                        font-size: 10px * root.scale;
                        font-weight: 600;
                        color: root.active_tab == 1 ? #60a5fa : #94a3b8;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    clicked => { root.active_tab = 1; }
                }
            }
        }

        // Subheader Action Row with Tips and Select All / Clear
        HorizontalLayout {
            alignment: space-between;
            height: 18px * root.scale;

            Text {
                text: root.active_tab == 0 ? "提示: 勾选分组将在主界面展示其速度、延迟与成功率" : "提示: 勾选的模型将自动映射并在所属分组下列出";
                font-size: 9.5px * root.scale;
                color: #94a3b8;
                vertical-alignment: center;
            }

            HorizontalLayout {
                spacing: 10px * root.scale;
                alignment: end;

                Rectangle {
                    Text {
                        text: "全选";
                        font-size: 9.5px * root.scale;
                        font-weight: 600;
                        color: #60a5fa;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => {
                            if root.active_tab == 0 {
                                root.select_all_groups();
                            } else {
                                root.select_all_models();
                            }
                        }
                    }
                }

                Rectangle {
                    Text {
                        text: "清空";
                        font-size: 9.5px * root.scale;
                        font-weight: 600;
                        color: #64748b;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => {
                            if root.active_tab == 0 {
                                root.clear_all_groups();
                            } else {
                                root.clear_all_models();
                            }
                        }
                    }
                }
            }
        }

        // Content: Tab 0 (Groups) vs Tab 1 (Models)
        if root.active_tab == 0 : VerticalLayout {
            spacing: 3px * root.scale;

            // Table Column Header
            HorizontalLayout {
                height: 18px * root.scale;
                padding-left: 8px * root.scale;
                padding-right: 8px * root.scale;
                spacing: 4px * root.scale;

                Text {
                    text: "分组名称";
                    font-size: 9px * root.scale;
                    font-weight: 700;
                    color: #64748b;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }

                Rectangle { width: 44px * root.scale; Text { text: "倍率"; font-size: 9px * root.scale; font-weight: 700; color: #64748b; horizontal-alignment: center; vertical-alignment: center; } }
                Rectangle { width: 50px * root.scale; Text { text: "速度"; font-size: 9px * root.scale; font-weight: 700; color: #64748b; horizontal-alignment: right; vertical-alignment: center; } }
                Rectangle { width: 48px * root.scale; Text { text: "延迟"; font-size: 9px * root.scale; font-weight: 700; color: #64748b; horizontal-alignment: right; vertical-alignment: center; } }
                Rectangle { width: 52px * root.scale; Text { text: "成功率"; font-size: 9px * root.scale; font-weight: 700; color: #64748b; horizontal-alignment: center; vertical-alignment: center; } }
            }

            // Scrollable Group List
            Flickable {
                content-height: root.groups.length * (28px * root.scale);

                VerticalLayout {
                    spacing: 3px * root.scale;

                    for item[idx] in root.groups: Rectangle {
                        height: 25px * root.scale;
                        border-radius: 4px * root.scale;
                        background: item.is_selected ? rgba(16, 185, 129, 0.08) : (ta_grp.has-hover ? rgba(255, 255, 255, 0.05) : rgba(255, 255, 255, 0.02));
                        border-width: 1px;
                        border-color: item.is_selected ? rgba(16, 185, 129, 0.3) : rgba(255, 255, 255, 0.05);

                        ta_grp := TouchArea {
                            clicked => { root.toggle_group_selected(idx, !item.is_selected); }
                        }

                        HorizontalLayout {
                            padding-left: 8px * root.scale;
                            padding-right: 8px * root.scale;
                            spacing: 6px * root.scale;

                            // Checkbox
                            Rectangle {
                                width: 14px * root.scale;
                                height: 14px * root.scale;
                                border-radius: 3px * root.scale;
                                border-width: 1px;
                                border-color: item.is_selected ? #10b981 : rgba(255, 255, 255, 0.25);
                                background: item.is_selected ? #10b981 : rgba(255, 255, 255, 0.05);
                                y: (parent.height - self.height) / 2;

                                if item.is_selected: Text {
                                    text: "✓";
                                    font-size: 9px * root.scale;
                                    font-weight: 800;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // Group Name
                            Text {
                                text: item.name;
                                font-size: 10px * root.scale;
                                font-weight: 600;
                                color: item.is_selected ? #ffffff : #cbd5e1;
                                vertical-alignment: center;
                                horizontal-alignment: left;
                            }

                            // Multiplier
                            Rectangle {
                                width: 44px * root.scale;
                                height: 18px * root.scale;
                                background: rgba(59, 130, 246, 0.2);
                                border-radius: 3px * root.scale;
                                y: (parent.height - self.height) / 2;

                                Text {
                                    text: item.multiplier;
                                    font-size: 9px * root.scale;
                                    font-weight: 700;
                                    color: #60a5fa;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // Speed
                            Rectangle {
                                width: 50px * root.scale;
                                Text {
                                    text: item.tps;
                                    font-size: 9px * root.scale;
                                    color: #cbd5e1;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }

                            // Latency
                            Rectangle {
                                width: 48px * root.scale;
                                Text {
                                    text: item.latency;
                                    font-size: 9px * root.scale;
                                    color: #94a3b8;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }

                            // Success rate
                            Rectangle {
                                width: 52px * root.scale;
                                Text {
                                    text: item.success_rate;
                                    font-size: 9px * root.scale;
                                    font-weight: 700;
                                    color: #10b981;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.active_tab == 1 : VerticalLayout {
            spacing: 3px * root.scale;

            // Scrollable Model List
            Flickable {
                content-height: root.models.length * (28px * root.scale);

                VerticalLayout {
                    spacing: 3px * root.scale;

                    for m[idx] in root.models: Rectangle {
                        height: 25px * root.scale;
                        border-radius: 4px * root.scale;
                        background: m.is_selected ? rgba(16, 185, 129, 0.08) : (ta_mdl.has-hover ? rgba(255, 255, 255, 0.05) : rgba(255, 255, 255, 0.02));
                        border-width: 1px;
                        border-color: m.is_selected ? rgba(16, 185, 129, 0.3) : rgba(255, 255, 255, 0.05);

                        ta_mdl := TouchArea {
                            clicked => { root.toggle_model_selected(idx, !m.is_selected); }
                        }

                        HorizontalLayout {
                            padding-left: 8px * root.scale;
                            padding-right: 8px * root.scale;
                            spacing: 8px * root.scale;

                            // Checkbox
                            Rectangle {
                                width: 14px * root.scale;
                                height: 14px * root.scale;
                                border-radius: 3px * root.scale;
                                border-width: 1px;
                                border-color: m.is_selected ? #10b981 : rgba(255, 255, 255, 0.25);
                                background: m.is_selected ? #10b981 : rgba(255, 255, 255, 0.05);
                                y: (parent.height - self.height) / 2;

                                if m.is_selected: Text {
                                    text: "✓";
                                    font-size: 9px * root.scale;
                                    font-weight: 800;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // Model Name / Label (e.g. claude-fable-5 (claude-fable-5))
                            Text {
                                text: m.label;
                                font-size: 10px * root.scale;
                                font-weight: 600;
                                color: m.is_selected ? #ffffff : #cbd5e1;
                                vertical-alignment: center;
                                horizontal-alignment: left;
                            }

                            // Badge: 支持 X 个分组
                            Rectangle {
                                width: 90px * root.scale;
                                Text {
                                    text: "支持 " + m.supported_groups_count + " 个分组";
                                    font-size: 9.5px * root.scale;
                                    color: #64748b;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Footer: Preset button on left, count summary in center, Save button on right
        HorizontalLayout {
            alignment: space-between;
            height: 26px * root.scale;

            Rectangle {
                background: rgba(59, 130, 246, 0.15);
                border-width: 1px;
                border-color: rgba(59, 130, 246, 0.3);
                border-radius: 5px * root.scale;
                height: 24px * root.scale;

                HorizontalLayout {
                    padding-left: 10px * root.scale;
                    padding-right: 10px * root.scale;
                    alignment: center;
                    Text {
                        text: "推荐预设";
                        font-size: 10px * root.scale;
                        color: #60a5fa;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    clicked => { root.apply_preset(); }
                }
            }

            Text {
                text: "已勾选: " + root.selected_groups_count + " 个分组 / " + root.selected_models_count + " 个模型";
                font-size: 9.5px * root.scale;
                color: #94a3b8;
                vertical-alignment: center;
                horizontal-alignment: center;
            }

            Rectangle {
                background: #10b981;
                border-radius: 5px * root.scale;
                height: 24px * root.scale;

                HorizontalLayout {
                    padding-left: 12px * root.scale;
                    padding-right: 12px * root.scale;
                    alignment: center;
                    Text {
                        text: "保存并应用";
                        font-size: 10.5px * root.scale;
                        font-weight: 700;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    clicked => { root.save_and_apply(); }
                }
            }
        }
    }
}
