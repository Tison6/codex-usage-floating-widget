import { Theme } from "../style.slint";

export struct BluetoothDeviceInfo {
    name: string,
    battery: int,
    icon: string,
}

export component CodexCard inherits Rectangle {
    in property <float> scale: 1.0;
    in property <bool> codex_running: false;
    in property <string> plan_type: "PLUS";
    in property <int> weekly_remaining_pct: 56;
    in property <string> countdown_str: "5d 14h";
    in property <int> five_hour_remaining_pct: 100;
    in property <string> five_hour_countdown_str: "3h 12m";
    in property <color> five_hour_color: #10b981;
    in property <bool> has_five_hour: true;
    in property <int> reset_credits: 1;
    in property <bool> is_error: false;
    in property <string> updated_time: "刚刚";
    in property <image> sparkline_image;
    in property <string> exhaustion_str: "预计分析中...";
    in property <[BluetoothDeviceInfo]> bt_devices: [];

    callback refresh_codex();

    background: rgba(17, 24, 39, 0.7);
    border-radius: 6px * root.scale;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);

    VerticalLayout {
        padding: 7px * root.scale;
        spacing: 4px * root.scale;

        // Bluetooth Header
        HorizontalLayout {
            alignment: space-between;
            HorizontalLayout {
                spacing: 3px * root.scale;
                Text {
                    text: "⚡ 蓝牙外设";
                    font-size: 9px * root.scale;
                    font-weight: 700;
                    color: #cbd5e1;
                    vertical-alignment: center;
                }
            }
            Text {
                text: root.bt_devices.length + " 已连";
                font-size: 8px * root.scale;
                color: #64748b;
                vertical-alignment: center;
            }
        }

        // Bluetooth Devices
        if root.bt_devices.length == 0: HorizontalLayout {
            height: 18px * root.scale;
            alignment: start;
            Text {
                text: "无在线蓝牙外设";
                font-size: 8px * root.scale;
                color: #64748b;
                vertical-alignment: center;
            }
        }
        for dev in root.bt_devices: HorizontalLayout {
            spacing: 5px * root.scale;
            alignment: space-between;

            HorizontalLayout {
                spacing: 3px * root.scale;
                Text {
                    text: dev.icon;
                    font-size: 9px * root.scale;
                    vertical-alignment: center;
                }
                Text {
                    text: dev.name;
                    font-size: 8.5px * root.scale;
                    color: #e2e8f0;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 4px * root.scale;
                // Battery Bar
                Rectangle {
                    width: 30px * root.scale;
                    height: 5px * root.scale;
                    border-radius: 2.5px * root.scale;
                    background: rgba(255, 255, 255, 0.1);
                    y: (parent.height - self.height) / 2;

                    Rectangle {
                        width: parent.width * (dev.battery / 100.0);
                        height: parent.height;
                        border-radius: 2.5px * root.scale;
                        background: dev.battery > 50 ? #10b981 : (dev.battery > 20 ? #f59e0b : #ef4444);
                        x: 0;
                    }
                }

                Text {
                    text: dev.battery + "%";
                    font-size: 8px * root.scale;
                    font-weight: 600;
                    color: dev.battery > 50 ? #34d399 : #f59e0b;
                    vertical-alignment: center;
                }
            }
        }

        // Divider
        Rectangle {
            height: 1px;
            background: rgba(255, 255, 255, 0.06);
        }

        // ChatGPT Header
        HorizontalLayout {
            alignment: space-between;

            HorizontalLayout {
                spacing: 5px * root.scale;
                Text {
                    text: "ChatGPT";
                    font-size: 10px * root.scale;
                    font-weight: 700;
                    color: #f8fafc;
                    vertical-alignment: center;
                }
                Rectangle {
                    background: rgba(59, 130, 246, 0.2);
                    border-radius: 3px * root.scale;
                    border-width: 1px;
                    border-color: rgba(59, 130, 246, 0.4);
                    height: 14px * root.scale;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 3px * root.scale;
                        padding-right: 3px * root.scale;
                        alignment: center;

                        Text {
                            text: root.plan_type;
                            font-size: 7.5px * root.scale;
                            font-weight: 700;
                            color: #60a5fa;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                width: 16px * root.scale;
                height: 16px * root.scale;
                border-radius: 3px * root.scale;
                background: transparent;
                Image {
                    source: @image-url("../../assets/refresh.svg");
                    width: 10px * root.scale;
                    height: 10px * root.scale;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                TouchArea {
                    clicked => { root.refresh_codex(); }
                }
            }
        }

        // 5H Quota Title & Percentage
        if (root.has_five_hour && !root.is_error): VerticalLayout {
            spacing: 2px * root.scale;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "5H 额度";
                    font-size: 8.5px * root.scale;
                    font-weight: 600;
                    color: #94a3b8;
                    vertical-alignment: center;
                }
                Text {
                    text: "剩 " + root.five_hour_remaining_pct + "%";
                    font-size: 9px * root.scale;
                    font-weight: 700;
                    color: root.five_hour_color;
                    vertical-alignment: center;
                }
            }

            // 5H Progress Bar
            Rectangle {
                height: 4px * root.scale;
                border-radius: 2px * root.scale;
                background: rgba(255, 255, 255, 0.08);

                Rectangle {
                    width: parent.width * (root.five_hour_remaining_pct / 100.0);
                    height: parent.height;
                    border-radius: 2px * root.scale;
                    background: root.five_hour_color;
                    x: 0;
                }
            }

            Text {
                text: "倒计时: " + root.five_hour_countdown_str;
                font-size: 7.5px * root.scale;
                color: #64748b;
                vertical-alignment: center;
            }
        }

        // Weekly Quota Title & Percentage
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "周限额";
                font-size: 9px * root.scale;
                font-weight: 600;
                color: #94a3b8;
                vertical-alignment: center;
            }
            Text {
                text: root.is_error ? "异常" : ("剩 " + root.weekly_remaining_pct + "%");
                font-size: 9.5px * root.scale;
                font-weight: 700;
                color: root.is_error ? #ef4444 : (root.weekly_remaining_pct > 30 ? #38bdf8 : #f59e0b);
                vertical-alignment: center;
            }
        }

        // Weekly Progress Bar
        Rectangle {
            height: 4px * root.scale;
            border-radius: 2px * root.scale;
            background: rgba(255, 255, 255, 0.08);

            Rectangle {
                width: root.is_error ? 0px : (parent.width * (root.weekly_remaining_pct / 100.0));
                height: parent.height;
                border-radius: 2px * root.scale;
                background: root.weekly_remaining_pct > 30 ? #3b82f6 : (root.weekly_remaining_pct > 15 ? #f59e0b : #ef4444);
                x: 0;
            }
        }

        // 7-Day Sparkline Curve with Grid
        Image {
            source: root.sparkline_image;
            height: 52px * root.scale;
            horizontal-alignment: center;
        }

        // Countdown (Line 1) & Exhaustion Prediction (Line 2, Bold)
        VerticalLayout {
            spacing: 1px * root.scale;
            Text {
                text: "倒计时: " + root.countdown_str;
                font-size: 7.5px * root.scale;
                color: #9ca3af;
                vertical-alignment: center;
            }
            Text {
                text: root.exhaustion_str;
                font-size: 7.5px * root.scale;
                font-weight: 700;
                color: #f3f4f6;
                vertical-alignment: center;
            }
        }

        // Footer (Credits badge & Update time)
        HorizontalLayout {
            alignment: space-between;

            Rectangle {
                background: rgba(16, 185, 129, 0.15);
                border-radius: 3px * root.scale;
                border-width: 1px;
                border-color: rgba(16, 185, 129, 0.3);
                height: 15px * root.scale;

                HorizontalLayout {
                    padding-left: 4px * root.scale;
                    padding-right: 4px * root.scale;
                    alignment: center;

                    Text {
                        text: "🎁 积分: " + root.reset_credits;
                        font-size: 7.5px * root.scale;
                        font-weight: 700;
                        color: #34d399;
                        vertical-alignment: center;
                    }
                }
            }

            Text {
                text: "更新: " + root.updated_time;
                font-size: 7.5px * root.scale;
                color: #475569;
                vertical-alignment: center;
            }
        }
    }
}
